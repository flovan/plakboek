{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/core/tests/fixture-host/build*/**",
    "packages/core/tests/fixture-host/.react-router/**",
    "packages/core/tests/e2e-host/build/**",
    "packages/core/tests/e2e-host/.react-router/**",
    "packages/core/test-results/**",
    "packages/core/playwright-report/**",
    ".planning/**",
    ".claude/**",
    ".gsd/**",
    "**/.github/**",
    "pnpm-lock.yaml",
    "**/CHANGELOG.md"
  ]
}
