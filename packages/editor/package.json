{
  "name": "@plakboek/editor",
  "version": "0.7.0",
  "description": "On-page editing chrome for Plakboek: shadow-root styles, strings and icons, with a server and a client entry",
  "homepage": "https://github.com/flovan/plakboek/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/flovan/plakboek/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flovan/plakboek.git",
    "directory": "packages/editor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./hot": {
      "types": "./dist/hot.d.ts",
      "default": "./dist/hot.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:css": "node scripts/build-chrome-css.ts",
    "build": "node scripts/build-chrome-css.ts && tsdown",
    "test": "node scripts/build-chrome-css.ts && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "node scripts/build-chrome-css.ts && tsc --noEmit -p tsconfig.json",
    "check": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@plakboek/auth": "workspace:*",
    "@plakboek/pages": "workspace:*",
    "@plakboek/permissions": "workspace:*",
    "@plakboek/render": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@plakboek/content": "workspace:*",
    "@plakboek/db": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "catalog:",
    "es-module-lexer": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  }
}
