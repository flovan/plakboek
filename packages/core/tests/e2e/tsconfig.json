{
  // The browser-facing half of the Playwright suite: page.evaluate callbacks
  // run in the browser, so they are typed against the DOM. Global setup and
  // the config import server code and stay in ../../tsconfig.json. The user
  // helper reaches the e2e host's config, whose blocks are JSX.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "helpers/site-behaviour.ts",
    "helpers/snapshots.ts",
    "helpers/host.ts",
    "**/*.spec.ts"
  ]
}
