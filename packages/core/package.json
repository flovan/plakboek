{
  "name": "@plakboek/core",
  "version": "0.5.0",
  "description": "The Plakboek host integration: routes, Vite plugin, production server and configuration for a scaffolded site",
  "homepage": "https://github.com/flovan/plakboek/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/flovan/plakboek/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flovan/plakboek.git",
    "directory": "packages/core"
  },
  "bin": {
    "plakboek": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./route-modules/*": {
      "types": "./dist/route-modules/*.d.ts",
      "default": "./dist/route-modules/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@plakboek/auth": "workspace:*",
    "@plakboek/cache": "workspace:*",
    "@plakboek/content": "workspace:*",
    "@plakboek/db": "workspace:*",
    "@plakboek/pages": "workspace:*",
    "@plakboek/permissions": "workspace:*",
    "@plakboek/render": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@react-router/dev": "catalog:",
    "@react-router/node": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "es-module-lexer": "catalog:",
    "isbot": "catalog:",
    "pg": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@react-router/dev": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@react-router/dev": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22"
  }
}
