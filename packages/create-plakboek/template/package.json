{
  "name": "__PACKAGE_NAME__",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env server.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "plakboek": "plakboek",
    "secret": "node -e \"process.stdout.write('PLAKBOEK_SECRET=' + process.getBuiltinModule('node:crypto').randomBytes(32).toString('base64url') + '\\n')\""
  },
  "dependencies": {
    "@plakboek/core": "__PLAKBOEK_VERSION__",
    "@plakboek/render": "__PLAKBOEK_VERSION__",
    "@react-router/node": "^8.4.0",
    "isbot": "^5.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@12.4.1"
}
