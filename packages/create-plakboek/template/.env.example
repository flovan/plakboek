# Copy this file to .env for local development. Never commit .env.
#
# Local Postgres (the compose file in this project reads these three).
POSTGRES_USER=plakboek
POSTGRES_PASSWORD=plakboek
POSTGRES_DB=plakboek

DATABASE_URL=postgres://plakboek:plakboek@127.0.0.1:5432/plakboek
# Migrations need a direct (session) connection. Set this only when
# DATABASE_URL points at a connection pooler.
# DATABASE_MIGRATION_URL=postgres://plakboek:plakboek@127.0.0.1:5432/plakboek

# The public origin of the site, without a path.
PLAKBOEK_URL=http://localhost:5173

# Every installation needs its own random secret. Generate it once with
#   pnpm --silent secret >> .env
# which appends a PLAKBOEK_SECRET= line. There is deliberately no default.

# SMTP mail transport. An empty host selects the development console mail
# sender; production requires a value. Any SMTP server works.
PLAKBOEK_SMTP_HOST=
PLAKBOEK_SMTP_PORT=587
# true for implicit TLS on 465; STARTTLS is always required otherwise.
PLAKBOEK_SMTP_SECURE=false
PLAKBOEK_SMTP_USER=
PLAKBOEK_SMTP_PASS=
# A bare address: a display name such as "Site <...>" is rejected.
PLAKBOEK_MAIL_FROM=no-reply@example.test

# The address the reverse proxy serves in production.
SITE_ADDRESS=localhost
