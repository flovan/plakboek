# Local development credentials only -- never used in CI or production.
# Start Postgres first: docker compose up -d --wait postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/plakboek
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Development-only value -- must be a distinct random string per installation.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# SMTP mail transport. An empty host selects the development console mail
# sender; production requires a value. Any SMTP server works, e.g. a dedicated
# mailbox on the customer's own server or an EU relay such as Lettermint or
# Scaleway TEM.
PLAKBOEK_SMTP_HOST=
PLAKBOEK_SMTP_PORT=587
# true for implicit TLS on 465; STARTTLS is always required otherwise.
PLAKBOEK_SMTP_SECURE=false
PLAKBOEK_SMTP_USER=
PLAKBOEK_SMTP_PASS=
PLAKBOEK_MAIL_FROM=Plakboek <no-reply@example.test>
